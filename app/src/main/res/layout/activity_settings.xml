<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_settings.xml — Settings screen host layout.
    Top bar matches main screen style: large bold title + back button.
    The FrameLayout below hosts the PreferenceFragment via FragmentManager.
    No ?attr/ colors — @color/ only, so it is safe under any theme context.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:orientation="vertical">

    <!-- ══════════════════════════════════════════════
         TOP BAR — large bold "Settings" title + back
         ══════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_background"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <!-- Back / up arrow button -->
        <FrameLayout
            android:id="@+id/flBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/ibBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@android:string/cancel"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back_black_24dp"
                app:tint="@color/color_label_secondary" />
        </FrameLayout>

        <!-- Large bold title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/menu_settings"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/flBack"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════════════
         PREFERENCE FRAGMENT HOST
         FragmentSettings is loaded here via FragmentManager
         ══════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/settings_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

