<?xml version="1.0" encoding="utf-8"?>
<!-- spyware_row.xml — one flagged app card in the spyware scanner. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/color_surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: icon container, app info, risk badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rounded square icon container -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_stat_blue">

                <ImageView
                    android:id="@+id/ivIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_theme_onBackground"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Phone Tracker" />

                <TextView
                    android:id="@+id/tvPackage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/color_label_secondary"
                    android:textSize="12sp"
                    tools:text="com.example.stalkerware.sample" />
            </LinearLayout>

            <!-- Risk pill badge -->
            <TextView
                android:id="@+id/tvRisk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/md_theme_onPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="HIGH RISK" />
        </LinearLayout>

        <!-- Reasons list -->
        <TextView
            android:id="@+id/tvReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="13sp"
            tools:text="• Hides itself — no icon in the app launcher&#10;• Installed from outside the Play Store" />

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlock"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Block network"
                android:textAllCaps="false"
                android:textColor="@color/color_off"
                android:textSize="13sp"
                app:backgroundTint="#FFE5E5"
                app:cornerRadius="19dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUninstall"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Uninstall"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_primary"
                android:textSize="13sp"
                app:backgroundTint="#E0EEFF"
                app:cornerRadius="19dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
