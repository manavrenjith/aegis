<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        values-v23-night/themes.xml
        windowLightStatusBar=false is already the default for Dark themes;
        no override needed at this API level for dark mode.
        File kept as a placeholder so the folder is not empty.
    -->
    <!-- API 23+ dark: keep light status bar false (dark icons won't show on dark bg) -->
    <style name="Theme.Aegis" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/md_theme_background</item>
    </style>
</resources>
